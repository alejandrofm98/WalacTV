<?xml version="1.0" encoding="utf-8"?>
<!-- Custom controller layout for VOD (movies/series) playback.
     Inspired by Stremio: seekbar on top, controls underneath.
     Media3 PlayerControlView binds automatically to views with @id/exo_* IDs. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/vod_pause_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/vod_pause_scrim"
        android:visibility="gone" />

    <!-- Top gradient + title bar -->
    <FrameLayout
        android:id="@+id/vod_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top">

        <View
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:background="@drawable/vod_gradient_top" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="40dp"
            android:layout_marginTop="28dp"
            android:layout_marginEnd="40dp"
            android:gravity="top"
            android:orientation="horizontal">

            <!-- Columna izquierda: titulo, episodio y descripcion -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/vod_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:shadowColor="#80000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="8"
                    android:textColor="#FFFFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    tools:text="Breaking Bad" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/vod_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="#99FFFFFF"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif"
                        tools:text="S3 · E7 · One Minute" />

                    <TextView
                        android:id="@+id/vod_rating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#F0C75E"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:text="★ 8.4"
                        tools:visibility="visible" />
                </LinearLayout>

                <TextView
                    android:id="@+id/vod_description"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:maxLines="3"
                    android:shadowColor="#80000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="8"
                    android:textColor="#D9FFFFFF"
                    android:textSize="14sp"
                    android:visibility="gone"
                    tools:text="Mientras la tormenta corta la luz de todo el valle, Mara descubre en el desvan de la estacion un diario que reabre una investigacion cerrada hace veinte anos."
                    tools:visibility="visible" />
            </LinearLayout>

            <!-- Reloj superior derecho: hora actual + hora de fin -->
            <LinearLayout
                android:id="@+id/vod_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="4dp"
                 android:orientation="vertical"
                 android:paddingTop="8dp"
                 android:paddingBottom="8dp">

                 <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                     android:orientation="vertical">
                     <TextView
                         android:id="@+id/vod_clock_now_value"
                         android:layout_width="wrap_content"
                         android:layout_height="wrap_content"
                         android:layout_marginStart="60dp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#FFFFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="21:42" />
                </LinearLayout>

                 <LinearLayout
                     android:layout_width="wrap_content"
                     android:layout_height="wrap_content"
                     android:layout_marginTop="4dp"
                     android:gravity="center_vertical"
                     android:orientation="horizontal">

                     <TextView
                         android:layout_width="60dp"
                         android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                         android:text="@string/vod_clock_end"
                         android:textColor="#FFFFFFFF"
                         android:textSize="10sp"
                         android:textStyle="bold" />

                    <TextView
                         android:id="@+id/vod_clock_end_value"
                         android:layout_width="wrap_content"
                         android:layout_height="wrap_content"
                          android:layout_marginStart="0dp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#D9FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="22:14" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Bottom: gradient + seekbar + controls row (Stremio-style) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">

        <!-- Gradient fade above the controls -->
        <View
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:background="@drawable/vod_gradient_bottom" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#E6000000"
            android:orientation="vertical"
            android:paddingHorizontal="40dp"
            android:paddingTop="0dp"
            android:paddingBottom="28dp">

            <!-- Seek bar (full width, Stremio-style: bar first, controls below) -->
            <androidx.media3.ui.DefaultTimeBar
                android:id="@id/exo_progress"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                app:bar_height="3dp"
                app:scrubber_enabled_size="14dp"
                app:scrubber_dragged_size="18dp"
                app:played_color="#3260F0"
                app:unplayed_color="#33FFFFFF"
                app:buffered_color="#803260F0"
                app:scrubber_color="#3260F0" />

            <!-- Controls row: left group (play, next, subtitles, time) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Play / Pause (Media3 auto-binds this ID) -->
                <ImageButton
                    android:id="@id/exo_play_pause"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_vod_icon_button"
                    android:contentDescription="@string/vod_play_pause"
                    android:focusable="true"
                    android:scaleType="centerInside" />

                <!-- Next episode (only visible for series) -->
                <ImageButton
                    android:id="@+id/vod_btn_next"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="20dp"
                    android:background="@drawable/bg_vod_icon_button"
                    android:contentDescription="@string/vod_next_episode"
                    android:focusable="true"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_vod_next"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <!-- Audio track -->
                <ImageButton
                    android:id="@+id/vod_btn_audio"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="20dp"
                    android:background="@drawable/bg_vod_icon_button"
                    android:contentDescription="@string/vod_audio"
                    android:focusable="true"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_vod_audio"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <!-- Unified stream selector (audio + quality) -->
                <ImageButton
                    android:id="@+id/vod_btn_stream"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="20dp"
                    android:background="@drawable/bg_vod_icon_button"
                    android:contentDescription="@string/vod_stream"
                    android:focusable="true"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_vod_audio"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <!-- Subtitles -->
                <ImageButton
                    android:id="@+id/vod_btn_subtitles"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="20dp"
                    android:background="@drawable/bg_vod_icon_button"
                    android:contentDescription="@string/vod_subtitles"
                    android:focusable="true"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_vod_subtitles" />

                <!-- Time: current / duration -->
                <TextView
                    android:id="@+id/vod_position"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#B3FFFFFF"
                    android:textSize="13sp"
                    tools:text="0:03" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#55FFFFFF"
                    android:textSize="13sp"
                    android:text="@string/option_separator" />

                <TextView
                    android:id="@+id/vod_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#55FFFFFF"
                    android:textSize="13sp"
                    tools:text="41:28" />

                <!-- Spacer to push nothing to the right for now -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
